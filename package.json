{
  "name": "chess-improvement-indicator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension: improvement indicator (ii) on lichess.org and chess.com profiles",
  "scripts": {
    "test": "node --test \"tests/**/*.test.js\"",
    "collect:lichess": "node tools/collect.js lichess",
    "tail:lichess": "node tools/collect.js lichess --tail",
    "collect:chesscom": "node tools/collect.js chesscom",
    "tail:chesscom": "node tools/collect.js chesscom --tail",
    "link": "node tools/link.js",
    "fit": "node tools/fit.js"
  }
}
