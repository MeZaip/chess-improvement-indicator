{
  "manifest_version": 3,
  "name": "Chess Improvement Indicator",
  "version": "1.0.0",
  "description": "Shows an improvement indicator on Lichess and Chess.com profiles: how far a player has climbed vs. players with the same experience.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Chess Improvement Indicator"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://lichess.org/*",
    "https://api.chess.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://lichess.org/*"
      ],
      "js": [
        "src/content/badge.js",
        "src/content/lichess.js"
      ],
      "css": [
        "src/content/badge.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.chess.com/*"
      ],
      "js": [
        "src/content/badge.js",
        "src/content/chesscom.js"
      ],
      "css": [
        "src/content/badge.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
